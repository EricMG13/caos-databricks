# Fixed synthetic local values only. Copy to .env; never put real credentials here.
CAOS_DATABASE_URL=postgresql://caos_app:local-app-only@127.0.0.1:55436/caos_dev
CAOS_TEST_POSTGRES_URL=postgresql://postgres:local-test-admin-only@127.0.0.1:55437/postgres
# Where scripts/qualify.py keeps a paid run's database: the persistent dev server,
# never the in-memory test server above (docs/DECISIONS.md §100).
CAOS_QUALIFY_POSTGRES_URL=postgresql://caos_dev_admin:local-dev-admin-only@127.0.0.1:55436/caos_dev
CAOS_BLOB_ROOT=.dev-data/blobs
CAOS_TRUST_ROLE_HEADER=1
CAOS_REQUIRE_POSTGRES=1

# The local actor the dev UI proxy (make dev-ui) asserts; the browser cannot choose
# its own. Unset CAOS_DEV_USER and the API answers 401. Never read in production.
CAOS_DEV_USER=00000000-0000-4000-8000-00000000d001
CAOS_DEV_ROLE=ANALYST

# Live provider mode is optional and paid. Leave these names absent for normal work.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=
# OPENROUTER_PROVIDER=deepseek  # lowercase endpoint tag, not display name
# OPENROUTER_REASONING_EFFORT=
# CAOS_REQUIRE_PROVIDER=1

# The worker's dated price for exactly the configured model (§49):
# model,input_per_token,output_per_token,DATE. make dev-worker and
# scripts/qualify.py both read it; absent, the worker refuses
# PROVIDER_NOT_CONFIGURED before it claims anything. The per-run ceiling the
# live suite reads is a separate variable.
# CAOS_MODEL_PRICE=
# CAOS_LIVE_BUDGET_CEILING=

# Read by the production image and its edge only (see docs/DECISIONS.md §53
# and §93); leave them absent locally. CAOS_EDGE_TOKEN is the key the edge
# signs each request's assertion with -- a real secret: never here.
# CAOS_SITE_ROOT=/app/site
# CAOS_EDGE_TOKEN=
# CAOS_PUBLIC_ORIGIN=
