# Qualification inputs are frozen evidence; formatters must not change their bytes.
qualification/*/documents/* -text whitespace=-trailing-space

# The feature-status record is a dated inventory written CRLF. A tool that
# rewrote all 249 line endings while changing six rows (`fa6bbfe`) made the
# diff unreadable and the commit message untrue; this pins the bytes instead.
docs/feature-status.csv -text whitespace=cr-at-eol

# Byte-verified where they are used (invariant 4; icm/HOST_INTEGRITY_v1.json):
# a checkout that converts line endings -- Git for Windows does by default --
# must still hold these bytes, or the worker refuses to start (D79). The
# goldens and fixtures are digest-compared against the legacy host the same way.
vendor/deploy-v/** -text
icm/** -text
tests/parity/golden/** -text
tests/fixtures/** -text
